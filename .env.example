MOCK_MODE=true
POLL_INTERVAL=3
DASHBOARD_PORT=8080
SNMP_COMMUNITY=
SNMP_V3_AUTH_KEY=
SNMP_V3_PRIV_KEY=
SPEEDTEST_URL=
SPEEDTEST_INTERVAL=300
# Optional Bearer token for automation, 32–256 URL-safe characters.
DASHBOARD_TOKEN=
# Set the exact HTTPS origin when using a reverse proxy.
DASHBOARD_ORIGIN=
ALLOWED_ORIGINS=
# Explicit opt-in for HTTP with a private or loopback IP in DASHBOARD_ORIGIN.
ALLOW_INSECURE_LAN_HTTP=false
# Compose host address and port (container port is always 3000).
BIND_IP=127.0.0.1
PUBLISH_PORT=3000
DATABASE_FILE=data/app.db
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional YAML seed, imported once into an empty inventory.
DEVICES_FILE=config/devices.yaml
DEVICES_READ_ONLY=false

# Optional base64-encoded 32-byte master key. Leave blank to use data/.master.key.
SECRETS_MASTER_KEY=

# Optional read-only OPNsense gateway telemetry (live mode).
OPNSENSE_API_URL=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_API_CA_FILE=
